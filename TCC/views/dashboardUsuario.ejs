<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/dashUsuario.css">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
    >

    <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>

<body>

    <header class="header">

        <div class="header-left">

            <button
                id="menu-toggle"
                class="icon-button"
                type="button"
                aria-label="Abrir menu"
            >
                <i class="ph ph-list"></i>
            </button>

            <h1>Cidade Segura</h1>

        </div>


        <div class="header-right">

            <button
                class="notification-button"
                type="button"
                aria-label="Notificações"
            >
                <i class="ph ph-bell"></i>

                <span class="notification-badge">
                    1
                </span>
            </button>


            <div class="header-divider"></div>


            <button class="profile-button" type="button">

                <div class="profile-icon">
                    <i class="ph ph-user"></i>
                </div>

                <div class="profile-info">

                    <strong>
                        Nome do Usuário
                    </strong>

                    <span>
                        Usuário Padrão
                    </span>

                </div>

                <i class="ph ph-caret-down profile-arrow"></i>

            </button>

        </div>

    </header>


    <div
        id="sidebar-overlay"
        class="sidebar-overlay"
    ></div>


    <div class="page">

        <aside
            id="sidebar"
            class="sidebar"
        >

            <nav class="sidebar-nav">

                <a
                    href="/dashboard"
                    class="nav-item active"
                >
                    <i class="ph ph-squares-four"></i>
                    <span>Dashboard</span>
                </a>


                <a
                    href="/denuncias"
                    class="nav-item"
                >
                    <i class="ph ph-warning-circle"></i>
                    <span>Denúncia</span>
                </a>


                <a
                    href="/notificacoes"
                    class="nav-item"
                >
                    <i class="ph ph-bell-ringing"></i>
                    <span>Notificações</span>
                </a>

            </nav>


            <div class="sidebar-footer">

                <a
                    href="/logout"
                    class="logout"
                >
                    <i class="ph ph-sign-out"></i>
                    <span>Sair da conta</span>
                </a>

            </div>

        </aside>


        <main class="content">

            <div class="content-container">


                <div class="page-title">

                    <h2>
                        Visão Geral
                    </h2>

                    <p>
                        Acompanhe o status das suas solicitações.
                    </p>

                </div>


                <section class="report-banner">

                    <img
                        src="/img/banner-cidade-segura.png"
                        alt=""
                        class="banner-image"
                    >

                    <div class="banner-overlay"></div>


                    <div class="banner-content">

                        <div>

                            <h2>
                                Faça a diferença
                            </h2>

                            <p>
                                Ajude a manter um ambiente seguro
                                relatando incidentes importantes
                                com total sigilo.
                            </p>

                        </div>


                        <a
                            href="/denuncias/nova"
                            class="report-button"
                        >
                            <i class="ph ph-plus-circle"></i>

                            Realizar denúncia
                        </a>

                    </div>

                </section>


                <section class="status-section">

                    <div class="status-title">

                        <i class="ph ph-chart-line-up"></i>

                        <h2>
                            Andamento da denúncia atual
                        </h2>

                    </div>


                    <div class="progress-box">

                        <div class="progress">

                            <div class="progress-line"></div>

                            <div class="progress-line-active"></div>


                            <div class="progress-step completed">

                                <div class="step-icon">

                                    <i class="ph-bold ph-check"></i>

                                </div>

                                <span>
                                    Recebida
                                </span>

                            </div>


                            <div class="progress-step current">

                                <div class="step-icon">

                                    <i class="ph-bold ph-magnifying-glass"></i>

                                </div>

                                <span>
                                    Em Análise
                                </span>

                            </div>


                            <div class="progress-step">

                                <div class="step-icon">

                                    <i class="ph-bold ph-flag-checkered"></i>

                                </div>

                                <span>
                                    Concluída
                                </span>

                            </div>

                        </div>

                    </div>

                </section>


            </div>

        </main>

    </div>


    <script src="/js/dashboard.js"></script>

</body>
</html>