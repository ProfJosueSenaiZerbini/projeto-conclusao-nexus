<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SafeZone | Dashboard</title>

    <!-- CSS compartilhado -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/menu.css">

    <!-- CSS da dashboard -->
    <link rel="stylesheet" href="/css/dashUsuario.css">

    <!-- Fonte -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Ícones -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>

<body>

    <!-- HEADER -->
    <%- include("partials/header") %>

        <!-- MENU LATERAL -->
        <%- include("partials/menu") %>

            <!-- CONTEÚDO PRINCIPAL -->
            <main class="dashboard-main">

                <div class="dashboard-container">

                    <!-- TÍTULO -->
                    <section class="page-title">

                        <h1>Visão Geral</h1>

                        <p>
                            Acompanhe o status das suas solicitações.
                        </p>

                    </section>


                    <!-- BANNER -->
                    <section class="report-banner">

                        <img src="/img/UserDashBanner-FINAL.png" alt="Banner SafeZone" class="banner-image">

                        <div class="banner-overlay"></div>

                        <div class="banner-content">



                            <a href="/denunciaUsuario" class="report-button">

                                <i class="ph ph-plus-circle"></i>

                                <span>
                                    Realizar denúncia
                                </span>

                            </a>

                        </div>

                    </section>



                    <!-- MINHAS DENÚNCIAS RECENTES -->
                    <section class="denuncias-section">

                        <div class="denuncias-title">
                            <i class="ph ph-file-text"></i>
                            <h2>Minhas denúncias recentes</h2>
                        </div>

                        <div class="denuncias-lista">

                            <% if (denunciasRecentes && denunciasRecentes.length> 0) { %>

                                <% denunciasRecentes.forEach(denuncia=> { %>

                                    <article class="denuncia-card">

                                        <div class="denuncia-info">
                                            <h3>
                                                <%= denuncia.titulo %>
                                            </h3>

                                            <p>
                                                Categoria: <%= denuncia.tipo %>
                                            </p>

                                            <p>
                                                Data:
                                                <%= new Date(denuncia.dataAbertura).toLocaleDateString("pt-BR") %>
                                            </p>
                                        </div>

                                        <div class="denuncia-acoes">
                                            <span class="status-denuncia">
                                                <%= denuncia.status %>
                                            </span>

                                            <a href="/denunciaDetalhe/<%= denuncia.idDenuncia %>">
                                                Ver detalhes
                                            </a>
                                        </div>

                                    </article>

                                    <% }); %>

                                        <% } else { %>

                                            <p class="sem-denuncias">
                                                Você ainda não possui denúncias cadastradas.
                                            </p>

                                            <% } %>

                        </div>

                    </section>


                </div>

            </main>

</body>
<script src="/js/dashboardUsuario.js"></script>
</html>