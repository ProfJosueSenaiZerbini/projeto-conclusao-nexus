<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/dashUsuario.css">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/header.css">

    <link rel="stylesheet" href="/css/menu.css">
</head>

<body>

    <%- include("partials/header") %>

        <div class="page">

            <%- include("partials/menu") %>

        <main class="content">

            <div class="content-container">


                <div class="page-title">

                    <h2>
                        Visão Geral
                    </h2>

                    <p>
                        Acompanhe o status das suas solicitações.
                    </p>

                </div>


                <section class="report-banner">

                    <img src="/img/banner-cidade-segura.png" alt="" class="banner-image">

                    <div class="banner-overlay"></div>


                    <div class="banner-content">

                        <div>

                            <h2>
                                Faça a diferença
                            </h2>

                            <p>
                                Ajude a manter um ambiente seguro
                                relatando incidentes importantes
                                com total sigilo.
                            </p>

                        </div>


                        <a href="/denuncias/nova" class="report-button">
                            <i class="ph ph-plus-circle"></i>

                            Realizar denúncia
                        </a>

                    </div>

                </section>


                <section class="status-section">

                    <div class="status-title">

                        <i class="ph ph-chart-line-up"></i>

                        <h2>
                            Andamento da denúncia atual
                        </h2>

                    </div>


                    <div class="progress-box">

                        <div class="progress">

                            <div class="progress-line"></div>

                            <div class="progress-line-active"></div>


                            <div class="progress-step completed">

                                <div class="step-icon">

                                    <i class="ph-bold ph-check"></i>

                                </div>

                                <span>
                                    Recebida
                                </span>

                            </div>


                            <div class="progress-step current">

                                <div class="step-icon">

                                    <i class="ph-bold ph-magnifying-glass"></i>

                                </div>

                                <span>
                                    Em Análise
                                </span>

                            </div>


                            <div class="progress-step">

                                <div class="step-icon">

                                    <i class="ph-bold ph-flag-checkered"></i>

                                </div>

                                <span>
                                    Concluída
                                </span>

                            </div>

                        </div>

                    </div>

                </section>


            </div>

        </main>

        </div>
    </div>

</body>

</html>