                                </div>


                                <div class="informacao">

                                    <span>Tipo de denúncia</span>

                                    <strong>
                                        Iluminação pública
                                    </strong>

                                </div>


                                <div class="informacao">

                                    <span>Denunciante</span>

                                    <strong>
                                        João Pedro Silva
                                    </strong>

                                </div>


                                <div class="informacao">

                                    <span>Data de registro</span>

                                    <strong>
                                        10/09/2026
                                    </strong>

                                </div>


                                <div class="informacao informacao-local">

                                    <span>Localização</span>

                                    <strong>
                                        Rua das Flores, 120
                                    </strong>

                                </div>


                            </div>

                        </div>



                        <!-- DESCRIÇÃO -->

                        <div class="card">

                            <div class="card-header">

                                <div>

                                    <h2>Descrição</h2>

