
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gerenciar Fiscais | SafeZone</title>

    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/gerenciarFiscais.css">
</head>
<body>

    <%- include("partials/header") %>

    <%- include(usuario && usuario.tipo === 'admin'
        ? "partials/menuAdm"
        : "partials/menu") %>

    <main class="container">
        <h1>Gerenciar Fiscais</h1>

        <p class="descricao">
            Cadastre novos fiscais e consulte os fiscais já registrados no sistema.
        </p>

        <% if (mensagemErro) { %>
            <div class="mensagem erro" role="alert">
                <%= mensagemErro %>
            </div>
        <% } %>

        <% if (mensagemSucesso) { %>
            <div class="mensagem sucesso" role="status">
                <%= mensagemSucesso %>
            </div>
        <% } %>

        <section class="card">
            <h2>Cadastrar novo fiscal</h2>

            <form
                class="formulario"
                action="/gerenciarFiscais/cadastro"
                method="POST"
            >
                <div class="campos-grid">

                    <div class="coluna-campos">
                        <div class="campo">
                            <label for="nome">Nome completo</label>
                            <input
                                type="text"
                                id="nome"
                                name="nome"
                                autocomplete="name"
                                required
                            >
                        </div>

                        <div class="campo">
                            <label for="email">E-mail</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                autocomplete="email"
                                required
                            >
                        </div>
                    </div>

                    <div class="coluna-campos">
                        <div class="campo">
                            <label for="cpf">CPF</label>
                            <input
                                type="text"
                                id="cpf"
                                name="cpf"
                                required
                            >
                        </div>

                        <div class="campo">
                            <label for="senha">Senha inicial</label>
                            <input
                                type="password"
                                id="senha"
                                name="senha"
                                autocomplete="new-password"
                                required
                            >
                        </div>
                    </div>

                </div>

                <div class="campo campo-botao">
                    <button type="submit" class="botao">
                        Cadastrar fiscal
                    </button>
                </div>
            </form>
        </section>

        <section class="card">
            <h2>Fiscais cadastrados</h2>

            <div class="tabela-container">
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>CPF</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (fiscais && fiscais.length > 0) { %>
                            <% fiscais.forEach(function(fiscal) { %>
                                <tr>
                                    <td><%= fiscal.nome %></td>
                                    <td><%= fiscal.email %></td>
                                    <td><%= fiscal.cpf %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="vazio">
                                    Nenhum fiscal cadastrado.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>
