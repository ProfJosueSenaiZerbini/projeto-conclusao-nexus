<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gerenciar Fiscais | SafeZone</title>

    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/gerenciarFiscais.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>

<body>

    <!-- HEADER -->
    <%- include("partials/header") %>
        <div class="pagina">
            <div class="conteudo">

                <!-- MENU LATERAL -->
                <%- include("partials/menuAdm") %>

                    <main class="container">
                        <h1>Gerenciar Fiscais</h1>

                        <p class="descricao">
                            Cadastre novos fiscais e consulte os fiscais já registrados no sistema.
                        </p>

                        <% if (mensagemErro) { %>
                            <div class="mensagem erro" role="alert">
                                <%= mensagemErro %>
                            </div>
                            <% } %>

                                <% if (mensagemSucesso) { %>
                                    <div class="mensagem sucesso" role="status">
                                        <%= mensagemSucesso %>
                                    </div>
                                    <% } %>

                                        <section class="card">
                                            <h2>Cadastrar novo fiscal</h2>

                                            <form class="formulario" action="/gerenciarFiscais/cadastro" method="POST">
                                                <div class="campos-grid">
                                                    <div class="coluna-campos">
                                                        <div class="campo">
                                                            <label for="nome">Nome</label>
                                                            <input type="text" id="nome" name="nome"
                                                                placeholder="Nome completo" required>
                                                        </div>

                                                        <div class="campo">
                                                            <label for="cpf">CPF</label>
                                                            <input type="text" id="cpf" name="cpf"
                                                                placeholder="000.000.000-00" maxlength="14" required>
                                                        </div>
                                                    </div>

                                                    <div class="coluna-campos">
                                                        <div class="campo">
                                                            <label for="email">E-mail</label>
                                                            <input type="email" id="email" name="email"
                                                                placeholder="email@exemplo.com" required>
                                                        </div>

                                                        <div class="campo">
                                                            <label for="senha">Senha</label>
                                                            <input type="password" id="senha" name="senha"
                                                                minlength="8" placeholder="Mínimo de 8 caracteres" required>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="campo campo-localidades">
                                                    <label for="localidades">Localidades de atuação</label>
                                                    <p class="ajuda-localidades">Selecione uma ou mais localidades já cadastradas.</p>
                                                    <% if (localidades && localidades.length > 0) { %>
                                                        <div class="lista-localidades">
                                                            <% localidades.forEach(function(localidade) { %>
                                                                <label class="opcao-localidade">
                                                                    <input type="checkbox" name="localidades" value="<%= localidade.idLocalidade %>">
                                                                    <span><%= localidade.cidade %> - <%= localidade.estado %></span>
                                                                </label>
                                                            <% }); %>
                                                        </div>
                                                    <% } else { %>
                                                        <p class="aviso-localidades">Nenhuma localidade cadastrada. Cadastre uma localidade antes de cadastrar o fiscal.</p>
                                                    <% } %>
                                                </div>

                                                <div class="campo campo-botao">
                                                    <button type="submit" class="botao" <%= (!localidades || localidades.length === 0) ? 'disabled' : '' %>>
                                                        Cadastrar fiscal
                                                    </button>
                                                </div>
                                            </form>
                                        </section>

                                        <section class="card">
                                            <h2>Fiscais cadastrados</h2>

                                            <div class="tabela-container">
                                                <table>
                                                    <thead>
                                                        <tr>
                                                            <th>Nome</th>
                                                            <th>E-mail</th>
                                                            <th>CPF</th>
                                                            <th>Localidades de atuação</th>
                                                            <th>Status</th>
                                                            <th>Ação</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        <% if (fiscais && fiscais.length> 0) { %>
                                                            <% fiscais.forEach(function(fiscal) { %>
                                                                <tr>
                                                                    <td>
                                                                        <%= fiscal.nome %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.email %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.cpf %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.localidades
                                                                            || 'Nenhuma localidade atribuída' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.status==='ativo' ? 'Ativo'
                                                                            : 'Desativado' %>
                                                                    </td>
                                                                    <td>
                                                                        <% if (fiscal.status === 'ativo') { %>
                                                                            <form
                                                                                action="/gerenciarFiscais/<%= fiscal.id %>/desativar"
                                                                                method="POST"
                                                                                onsubmit="return confirm('Deseja desativar este fiscal? O histórico e as localidades atribuídas serão preservados.');">
                                                                                <button type="submit" class="btn-acao btn-desativar">Desativar</button>
                                                                            </form>
                                                                        <% } else { %>
                                                                            <form
                                                                                action="/gerenciarFiscais/<%= fiscal.id %>/reatribuir"
                                                                                method="POST"
                                                                                onsubmit="return confirm('Deseja reatribuir este fiscal e ativá-lo novamente?');">
                                                                                <button type="submit" class="btn-acao btn-reatribuir">Reatribuir</button>
                                                                            </form>
                                                                        <% } %>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="6" class="vazio">
                                                                                Nenhum fiscal cadastrado.
                                                                            </td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </section>
            </div>
        </div>

<%- include("partials/footer") %>
</body>
<script src="/js/formatarCpf.js"></script>

</html>

<!-- Widget de acessibilidade VLibras -->
<div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
        <div class="vw-plugin-top-wrapper"></div>
    </div>
</div>

<script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>

<script>
    new window.VLibras.Widget('https://vlibras.gov.br/app');
</script>