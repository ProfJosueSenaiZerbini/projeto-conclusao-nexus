<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gerenciar Fiscais | SafeZone</title>

    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/gerenciarFiscais.css">
</head>

<body>

    <!-- HEADER -->
    <%- include("partials/header") %>
        <div class="pagina">
            <div class="conteudo">

                <!-- MENU LATERAL -->
                <%- include("partials/menuAdm") %>

                    <main class="container">
                        <h1>Gerenciar Fiscais</h1>

                        <p class="descricao">
                            Cadastre novos fiscais e consulte os fiscais já registrados no sistema.
                        </p>

                        <% if (mensagemErro) { %>
                            <div class="mensagem erro" role="alert">
                                <%= mensagemErro %>
                            </div>
                            <% } %>

                                <% if (mensagemSucesso) { %>
                                    <div class="mensagem sucesso" role="status">
                                        <%= mensagemSucesso %>
                                    </div>
                                    <% } %>

                                        <section class="card">
                                            <h2>Cadastrar novo fiscal</h2>

                                            <form class="formulario" action="/gerenciarFiscais/cadastro" method="POST">
                                                <div class="campos-grid">

                                                    <div class="coluna-campos">
                                                        <div class="campo">
                                                            <label for="logradouro">Rua / Avenida</label>
            <input type="text" id="logradouro" name="logradouro"
                placeholder="Ex: Rua das Flores" required>
                                                        </div>

                                                        <div class="campo">
                                                            <label for="numero">Número</label>
            <input type="text" id="numero" name="numero"
                placeholder="Ex: 125" required>
                                                        </div>

                                                         <div class="campo">
            <label for="complemento">Complemento</label>
            <input type="text" id="complemento" name="complemento"
                placeholder="Ex: Casa 2">
        </div>
                                                    </div>

                                                    <div class="coluna-campos">
                                                        <div class="campo">
                                                            <label for="bairro">Bairro</label>
            <input type="text" id="bairro" name="bairro"
                placeholder="Ex: Centro" required>
                                                        </div>

                                                        <div class="campo">
                                                            <label for="cep">CEP</label>
            <input type="text" id="cep" name="cep"
                placeholder="00000-000" maxlength="9" required>
                                                        </div>

                                                        <div class="campo">
            <label for="cidade">Cidade</label>
            <input type="text" id="cidade" name="cidade"
                placeholder="Ex: Campinas" required>
        </div>

        <div class="campo">
            <label for="estado">Estado (UF)</label>
            <input type="text" id="estado" name="estado"
                placeholder="Ex: SP" maxlength="2" required>
                                                    </div>

                                                </div>


                                                <div class="campo campo-localidades">
                                                    <label>Localidades de atuação</label>

                                                    <p class="descricao">
                                                        Selecione todas as regiões em que este fiscal poderá trabalhar.
                                                    </p>

                                                    <% if (localidades && localidades.length> 0) { %>

                                                        <div class="lista-localidades">

                                                            <% localidades.forEach(function(localidade) { %>

                                                                <label class="opcao-localidade">
                                                                    <input type="checkbox" name="localidades[]"
                                                                        value="<%= localidade.idLocalidade %>">

                                                                    <span>
                                                                        <%= localidade.cidade %> -
                                                                            <%= localidade.estado %>
                                                                    </span>
                                                                </label>

                                                                <% }); %>

                                                        </div>
                                                        <% } else { %>
                                                            <p class="mensagem erro">
                                                                Nenhuma localidade cadastrada.
                                                                Cadastre uma localidade antes de registrar fiscais.
                                                            </p>
                                                            <% } %>
                                                </div>

                                                <div class="campo campo-botao">
                                                    <button type="submit" class="botao">
                                                        Cadastrar fiscal
                                                    </button>
                                                </div>
                                            </form>
                                        </section>

                                        <section class="card">
                                            <h2>Fiscais cadastrados</h2>

                                            <div class="tabela-container">
                                                <table>
                                                    <thead>
                                                        <tr>
                                                            <th>Nome</th>
                                                            <th>E-mail</th>
                                                            <th>CPF</th>
                                                            <th>Endereço</th>
                                                            <th>Localidades de atuação</th>
                                                            <th>Status</th>
                                                            <th>Ação</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        <% if (fiscais && fiscais.length> 0) { %>
                                                            <% fiscais.forEach(function(fiscal) { %>
                                                                <tr>
                                                                    <td>
                                                                        <%= fiscal.nome %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.email %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.cpf %>
                                                                    </td>
                                                                    <th>
                                                                        <%=fiscal.endereco ||
                                                                         'Endereço não informado'%>
                                                                    </th>
                                                                    <td>
                                                                        <%= fiscal.localidades
                                                                            || 'Nenhuma localidade atribuída' %>
                                                                    </td>
                                                                    <td>
                                                                        <%= fiscal.status==='ativo' ? 'Ativo'
                                                                            : 'Desativado' %>
                                                                    </td>
                                                                    <td>
                                                                        <% if (fiscal.status === 'ativo') { %>
                                                                            <form
                                                                                action="/gerenciarFiscais/<%= fiscal.id %>/desativar"
                                                                                method="POST"
                                                                                onsubmit="return confirm('Deseja desativar este fiscal? O histórico e as localidades atribuídas serão preservados.');">
                                                                                <button type="submit" class="btn-acao btn-desativar">Desativar</button>
                                                                            </form>
                                                                        <% } else { %>
                                                                            <form
                                                                                action="/gerenciarFiscais/<%= fiscal.id %>/reatribuir"
                                                                                method="POST"
                                                                                onsubmit="return confirm('Deseja reatribuir este fiscal e ativá-lo novamente?');">
                                                                                <button type="submit" class="btn-acao btn-reatribuir">Reatribuir</button>
                                                                            </form>
                                                                        <% } %>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="7" class="vazio">
                                                                                Nenhum fiscal cadastrado.
                                                                            </td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </section>
            </div>
        </div>


</body>
<script src="/js/formatarCpf.js"></script>

</html>