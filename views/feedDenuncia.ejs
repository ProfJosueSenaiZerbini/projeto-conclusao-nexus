<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feed de Denúncias</title>

    <link rel="stylesheet" href="/css/feed.css" />

    <link rel="stylesheet" href="/css/menu.css" />

    <link rel="stylesheet" href="/css/header.css" />
</head>

<body>
    <%- include("partials/header") %>

    <div class="pagina">
        <div class="container">

           <%- include(usuario && ['fiscal', 'superusuario'].includes(usuario.tipo) 
                    ? "partials/menuAdm" : "partials/menu") %>
                    
            <main class="area-feed">

                <section class="cabecalho-feed">
                    <h1>Feed de Denúncias</h1>
                    <p>Veja as denúncias públicas registradas e filtre pela categoria informada no cadastro.</p>
                    
                    <div class="pesquisa-feed">
                        <span class="icone-pesquisa" aria-hidden="true">⌕</span>
                        <input
                            type="search"
                            id="pesquisaFeed"
                            placeholder="Pesquisar denúncias..."
                            aria-label="Pesquisar denúncias"
                            autocomplete="off"
                        />
                        <button type="button" id="limparPesquisa" aria-label="Limpar pesquisa" hidden>×</button>
                    </div>
                    <p class="resultado-pesquisa" id="resultadoPesquisa" aria-live="polite"></p>
                </section>

                <section class="feed-vazio" id="feedVazio" <%= denuncias.length ? 'hidden' : '' %>>
                    <h2>Nenhuma denúncia encontrada</h2>
                    <p id="mensagemFeedVazio"><%= denuncias.length ? 'Nenhuma denúncia corresponde à sua pesquisa.' : 'Não há denúncias públicas no momento.' %></p>
                </section>

                <% denuncias.forEach(denuncia => { %>
                    <article class="feed-card">
                        <div class="feed-topo">
                            <div class="feed-usuario">
                                <div class="icone-local" aria-hidden="true">📍</div>
                                <div>
                                    <h2><%= denuncia.titulo %></h2>
                                    <span><%= denuncia.anonima ? 'Denúncia anônima' : denuncia.nomeUsuario %> • <%= denuncia.dataFormatada %></span>
                                </div>
                            </div>
                            <a href="/denunciaDetalhe/<%= denuncia.idDenuncia %>" class="ver-detalhes">Ver detalhes →</a>
                        </div>

                        <div class="feed-tags">
                            <span class="tag categoria"><%= denuncia.categoriaNome %></span>
                            <span class="tag bairro"><%= denuncia.endereco %></span>
                            <span class="tag status"><%= denuncia.status %></span>
                            <span class="tag prioridade">Prioridade: <%= denuncia.prioridade %></span>
                        </div>

                        <% denuncia.evidencias.forEach(evidencia => { %>
                            <% if (evidencia.dadosEvidencia && evidencia.tipoEvidencia === 'imagem') { %>
                                <img class="evidencia-feed" src="<%= evidencia.dadosEvidencia %>" alt="Imagem anexada à denúncia" loading="lazy" />
                            <% } else if (evidencia.dadosEvidencia && evidencia.tipoEvidencia === 'video') { %>
                                <video class="evidencia-feed" controls preload="metadata" aria-label="Vídeo anexado à denúncia">
                                    <source src="<%= evidencia.dadosEvidencia %>" />
                                    Seu navegador não suporta a reprodução de vídeo.
                                </video>
                            <% } %>
                        <% }) %>

                        <p class="descricao"><%= denuncia.descricao %></p>
                    </article>
                <% }) %>
            </main>
        </div>
    </div>
</body>

    <script src="/js/feedDenuncia.js"></script>
</html>
