
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SafeZone | Notificações</title>

    <!-- CSS compartilhado -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/menu.css">

    <!-- CSS da página -->
    <link rel="stylesheet" href="/css/notificacoes.css">

    <!-- Ícones -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <link rel="stylesheet" href="/css/footer.css">
</head>

<body>

    <!-- CABEÇALHO -->
    <%- include("partials/header") %>

    <div class="pagina">
        <div class="container">

            <!-- MENU LATERAL -->
            <% if (usuario && (usuario.tipo === "fiscal" || usuario.tipo === "superusuario")) { %>
                <%- include("partials/menuAdm") %>
            <% } else { %>
                <%- include("partials/menu") %>
            <% } %>

            <!-- CONTEÚDO PRINCIPAL -->
            <main class="area-notificacoes">

                <!-- TÍTULO -->
                <section class="cabecalho-notificacoes">

                    <div>
                        <h1>Notificações</h1>

                        <p>
                            Você possui
                            <strong><%= totalNaoLidas || 0 %></strong>
                            notificações não lidas.
                        </p>
                    </div>

                    <% if (notificacoes && notificacoes.some(n => Number(n.lida) === 0)) { %>

                        <form
                            action="/notificacoes/marcar-todas-lidas"
                            method="POST"
                        >
                            <button
                                type="submit"
                                class="marcar-lidas"
                            >
                                Marcar todas como lidas
                            </button>
                        </form>

                    <% } %>

                </section>

                <!-- LISTA DE NOTIFICAÇÕES -->
                <section class="lista-notificacoes">

                    <% if (notificacoes && notificacoes.length > 0) { %>

                        <% notificacoes.forEach(n => { %>

                            <a
                                href="/denunciaDetalhe/<%= n.denuncia_id %>"
                                class="link-notificacao"
                                data-id="<%= n.idNotificacao %>"
                                data-url="/denunciaDetalhe/<%= n.denuncia_id %>"
                            >

                                <article class="notificacao-item <%= Number(n.lida) === 0 ? 'nao-lida' : '' %>">

                                    <div class="notificacao-indicador"></div>

                                    <div class="notificacao-icone">
                                        <%= Number(n.lida) === 1 ? '✓' : '🔔' %>
                                    </div>

                                    <div class="notificacao-conteudo">

                                        <div class="notificacao-cabecalho">

                                            <h2>
                                                <%= n.titulo %>
                                            </h2>

                                            <span class="notificacao-horario">
                                                <%= n.horario %>
                                            </span>

                                        </div>

                                        <p>
                                            <%= n.mensagem %>
                                        </p>

                                        <span class="notificacao-data">
                                            <%= n.data %>
                                        </span>

                                    </div>

                                </article>

                            </a>

                        <% }) %>

                    <% } else { %>

                        <p class="sem-notificacoes">
                            Nenhuma notificação no momento.
                        </p>

                    <% } %>

                </section>

            </main>

        </div>
    </div>

    <%- include("partials/footer") %>

    <!-- JAVASCRIPT -->
    <script src="/js/notificacoes.js"></script>

</body>
</html>

<!-- Widget de acessibilidade VLibras -->
<div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
        <div class="vw-plugin-top-wrapper"></div>
    </div>
</div>

<script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>

<script>
    new window.VLibras.Widget('https://vlibras.gov.br/app');
</script>
