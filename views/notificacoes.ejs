<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notificações</title>

    <link rel="stylesheet" href="/css/notificacoes.css">

    <link rel="stylesheet" href="/css/header.css">

    <link rel="stylesheet" href="/css/menu.css">
</head>

<body>

    <%- include("partials/header") %>

        <div class="pagina">

            <div class="conteudo">

                <%- include("partials/menu") %>

                    <main class="area-notificacoes">
                        <div class="cabecalho-notificacoes">
                            <div>
                                <h1>Notificações</h1>
                                <p>Acompanhe as atualizações das suas denúncias.</p>
                            </div>
                            <form action="/notificacoes/marcar-todas-lidas" method="POST">
                                <button class="marcar-lidas" type="submit">Marcar todas como lidas</button>
                            </form>
                        </div>

                        <!-- LISTA DE NOTIFICAÇÕES -->
                        <div class="lista-notificacoes">
                            <% if (notificacoes && notificacoes.length> 0) { %>
                                <% notificacoes.forEach(n=> { %>
                                    <!-- O LINK ENVOLVE O CARD INTEIRO -->
                                    <a href="/denuncia/<%= n.denuncia_id %>" class="link-notificacao"
                                        style="text-decoration: none; color: inherit;">
                                        <article class="notificacao-item <%= n.lida ? '' : 'nao-lida' %>">
                                            <div class="notificacao-indicador"></div>
                                            <div class="notificacao-icone">
                                                <%= n.lida ? '✓' : '🔔' %>
                                            </div>
                                            <div class="notificacao-conteudo">
                                                <div class="notificacao-cabecalho">
                                                    <h2>
                                                        <%= n.titulo %>
                                                    </h2>
                                                    <span class="notificacao-horario">
                                                        <%= n.horario %>
                                                    </span>
                                                </div>
                                                <p>
                                                    <%= n.mensagem %>
                                                </p>
                                                <span class="notificacao-data">
                                                    <%= n.data %>
                                                </span>
                                            </div>
                                        </article>
                                    </a>
                                    <% }) %>
                                        <% } else { %>
                                            <p class="sem-notificacoes">Nenhuma notificação no momento.</p>
                                            <% } %>
                        </div>
                    </main>
                    <!-- MODAL DE CONFIRMAÇÃO ESTILIZADO -->
                    <div id="modal-confirmacao" class="modal-overlay hidden">
                        <div class="modal-card">
                            <h3>Marcar como lidas</h3>
                            <p>Deseja realmente marcar todas as notificações como lidas?</p>
                            <div class="modal-acoes">
                                <button id="btn-cancelar" class="btn-secundario">Cancelar</button>
                                <button id="btn-confirmar" class="btn-principal">Confirmar</button>
                            </div>
                        </div>
                    </div>
            </div>
        </div>

</body>

<script src="/js/notificacoes.js"></script>

</html>