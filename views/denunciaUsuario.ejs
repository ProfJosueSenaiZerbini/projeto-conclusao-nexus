<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Denúncias</title>

    <link rel="stylesheet" href="/css/denuncias.css">

    <link rel="stylesheet" href="/css/header.css">

    <link rel="stylesheet" href="/css/menu.css">
</head>

<body>

    <%- include("partials/header") %>

    <div class="pagina">

            <%- include("partials/header") %>

             <!-- Área da denuncia-->
              <main class="area-denuncia">

                <div class="formulario">

                    <!-- Tipo de denuncia-->
                     <div class="tipo">

                        <label>
                            <input type="radio" name="visibilidade" value="anonimo" checked>
                            Anônimo
                        </label>

                        <label>
                            <input type="radio" name="visibilidade" value="publico">
                            Público
                        </label>
                     </div>

                     <!-- titulo-->
                      <div class="titulo-denuncia">

                        <label>
                            Título da <br>
                            Denúncia:
                        </label>

                        <div class="categorias">

                            <input type="text">
                            <input type="text">

                            <input type="text">
                            <input type="text">

                            <button type="button">
                                Outros
                            </button>
                        </div>
                      </div>

                      <!--Botão denunciar-->
                      <button class="btn-denunciar">
                        Denuncia
                      </button>
                
                    </div>

                    <!--Parte direita-->
                    <div class="informacoes">

                        <!--Arquivo-->
                        <label class="caixa arquivo">

                            <input type="file" accept="image/*,video/*">

                            <span>
                                Adicionar arquivo de foto ou<br>
                                vídeo da denúncia
                            </span>

                        </label>

                        <!--Descrição-->
                        <textarea
                        class="caixa descricao"
                        placeholder="Descrição.."
                        ></textarea>

                        <!--Local-->
                        <input
                        type="text"
                        class="caixa local"
                        placeholder="Local"
                        >

                    </div>
              </main>
         </div>
    </div>

    <script src="/js/menu.js"></script>
    
</body>
</html>