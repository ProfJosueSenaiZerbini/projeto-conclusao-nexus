
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gerenciar localidades | SafeZone</title>

    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/gerenciarFiscais.css">
</head>
<body>

    <%- include("partials/header") %>
    <%- include("partials/menuAdm") %>

    <main class="container">
        <h1>Gerenciar localidades</h1>

        <p class="descricao">
            Cadastre as cidades e estados atendidos pela sua organização.
            As denúncias dessas localidades serão encaminhadas automaticamente
            para sua organização.
        </p>

        <% if (mensagemErro) { %>
            <div class="mensagem erro" role="alert">
                <%= mensagemErro %>
            </div>
        <% } %>

        <% if (mensagemSucesso) { %>
            <div class="mensagem sucesso" role="status">
                <%= mensagemSucesso %>
            </div>
        <% } %>

        <section class="card">
            <h2>Cadastrar nova localidade</h2>

            <form
                class="formulario"
                action="/organizacao/localidades"
                method="POST"
            >
                <div class="campos-grid">
                    <div class="campo">
                        <label for="cidade">Cidade</label>
                        <input
                            type="text"
                            id="cidade"
                            name="cidade"
                            maxlength="100"
                            placeholder="Ex.: Campinas"
                            required
                        >
                    </div>

                    <div class="campo">
                        <label for="estado">Estado (UF)</label>
                        <input
                            type="text"
                            id="estado"
                            name="estado"
                            maxlength="2"
                            minlength="2"
                            pattern="[A-Za-z]{2}"
                            placeholder="Ex.: SP"
                            required
                        >
                    </div>
                </div>

                <div class="campo campo-botao">
                    <button type="submit" class="botao">
                        Cadastrar localidade
                    </button>
                </div>
            </form>
        </section>

        <section class="card">
            <h2>Localidades cadastradas</h2>

            <div class="tabela-container">
                <table>
                    <thead>
                        <tr>
                            <th>Cidade</th>
                            <th>Estado</th>
                            <th>Data do cadastro</th>
                            <th>Ação</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (localidades && localidades.length > 0) { %>
                            <% localidades.forEach(function(localidade) { %>
                                <tr>
                                    <td><%= localidade.cidade %></td>
                                    <td><%= localidade.estado %></td>
                                    <td>
                                        <%= new Date(localidade.dataCadastro).toLocaleDateString('pt-BR') %>
                                    </td>
                                    <td>
                                        <form
                                            action="/organizacao/localidades/<%= localidade.id %>/remover"
                                            method="POST"
                                            onsubmit="return confirm('Deseja remover esta localidade?');"
                                        >
                                            <button type="submit">
                                                Remover
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="vazio">
                                    Nenhuma localidade cadastrada.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>
