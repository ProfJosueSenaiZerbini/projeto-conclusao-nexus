<!DOCTYPE html>
<html lang="pt-br"> 
<head>
    <meta charset="UTF-8">
    <title>PÁGINA LOGIN</title>
    <link rel="stylesheet" href="/css/login.css">
    <link rel="icon" href="/img/logo.png">
    <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
    
    <div class="container">
        
        <div class="login-box">


            <form action="/login" method="POST">

                <div class="logo">
                    <img src="/img/logo.png" alt="Logo">
                </div>

                <% if (mensagemErro) { %>
                    <p style="color: red; text-align: center;"><%= mensagemErro %></p>
                <% } %>

                <input 
                    type="email"
                    name="email"
                    placeholder="E-mail"
                    required
                />

                <div class="senha">
                    <input 
                        type="password"
                        id="inputSenha"
                        name="senha"
                        placeholder="Senha"
                        required
                    />
                    <button type="button" onclick="alternarSenha()"></button>
                </div>

                <button type="submit" class="btn-btn">Entrar</button>

                <p class="cadastro-link" style="margin: 0 auto;">
                    Não tem uma conta?
                    <a href="/cadastro">Cadastre-se</a>
                </p>
            </form>
        </div>
    </div>

    <%- include("partials/footer") %>

    <script src="/js/login.js"></script>

</body>
</html>

<!-- Widget de acessibilidade VLibras -->
<div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
        <div class="vw-plugin-top-wrapper"></div>
    </div>
</div>

<script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>

<script>
    new window.VLibras.Widget('https://vlibras.gov.br/app');
</script>